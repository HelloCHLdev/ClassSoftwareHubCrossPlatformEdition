<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="800"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:data="using:ClassSoftwareHubCrossPlatformEdition.Data"
             x:Class="ClassSoftwareHubCrossPlatformEdition.Pages.DetailPage">

    <!-- 和首页 / 设置页 / 软件下载页同一套版式：内容钉在中间 960 宽 -->
    <Grid Margin="24,20,24,44">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="998*" MaxWidth="960" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="1" RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 返回条（和内容左缘对齐） -->
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Click="Back_Click" Padding="8,4">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <ui:FASymbolIcon Symbol="Back" FontSize="12" />
                        <TextBlock Text="返回" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="14">

                    <!-- ===== 头部：图标 + 名称 + 标语 + 分类徽标 ===== -->
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <!-- 圆角 + 1:1 居中裁剪：固定 72×72 正方形，图标用 ImageBrush 填满 -->
                        <Border x:Name="IconBox" Width="72" Height="72" CornerRadius="14"
                                VerticalAlignment="Top" HorizontalAlignment="Left">
                            <Panel>
                                <ui:FASymbolIcon x:Name="IconFallback" Symbol="Shop" FontSize="30" Opacity="0.3"
                                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Panel>
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="6">
                            <TextBlock x:Name="AppName" FontSize="26" FontWeight="Bold" TextWrapping="Wrap" />
                            <TextBlock x:Name="AppTagline" FontSize="13" Opacity="0.75" TextWrapping="Wrap" />
                            <Border x:Name="CategoryBadge" CornerRadius="10" Padding="8,3"
                                    HorizontalAlignment="Left"
                                    Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                <TextBlock x:Name="CategoryText" FontSize="12" Opacity="0.85" />
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- 小提示（数据里 notice 字段） -->
                    <ui:FAInfoBar x:Name="NoticeBar" Severity="Informational" IsOpen="False" IsClosable="False" />

                    <!-- ===== 应用介绍 ===== -->
                    <TextBlock x:Name="IntroTitle" FontSize="18" FontWeight="Bold" Margin="0,6,0,0" />
                    <TextBlock x:Name="AppDescription" TextWrapping="Wrap" LineHeight="24" Opacity="0.9" />

                    <!-- ===== 详细信息（版本 / 体积 / 系统 / 官网 / GitHub） ===== -->
                    <TextBlock x:Name="InfoTitle" FontSize="18" FontWeight="Bold" Margin="0,6,0,0" />
                    <Border CornerRadius="8" Padding="16,14"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1">
                        <StackPanel x:Name="InfoList" Spacing="10" />
                    </Border>

                    <!-- ===== 下载 ===== -->
                    <TextBlock x:Name="DownloadsTitle" FontSize="18" FontWeight="Bold" Margin="0,6,0,0" />

                    <!-- 应用商店入口（store 字段，或 downloads 里指向商店的那条） -->
                    <Border x:Name="StoreCard" IsVisible="False" CornerRadius="8" Padding="16,14"
                            Background="{DynamicResource AccentFillColorDefaultBrush}">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock x:Name="StoreTitle" FontSize="15" FontWeight="Bold" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                <TextBlock x:Name="StoreDesc" FontSize="12" TextWrapping="Wrap" Opacity="0.85"
                                           Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                            </StackPanel>
                            <Button x:Name="StoreButton" Grid.Column="1" VerticalAlignment="Center"
                                    Click="Store_Click"
                                    Background="Transparent"
                                    Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" />
                        </Grid>
                    </Border>

                    <TextBlock x:Name="StoreOnlyHint" IsVisible="False" FontSize="12.5" Opacity="0.7"
                               TextWrapping="Wrap" />

                    <!-- 下载项：平台 / 备注 / 体积 / 校验值（点击复制） + 下载 + 加速下载 -->
                    <ItemsControl x:Name="DownloadList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="data:DownloadItem">
                                <Border CornerRadius="8" Padding="16,12" Margin="0,0,0,8"
                                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="{Binding Platform}" FontWeight="Bold" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Note}" FontSize="12" Opacity="0.7"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Size}" FontSize="12" Opacity="0.7"
                                                       TextWrapping="Wrap" />
                                            <Button Content="{Binding HashChipText}" Tag="{Binding Hash}"
                                                    IsVisible="{Binding HashVisibility}"
                                                    Click="CopyHash_Click" HorizontalAlignment="Left"
                                                    Padding="8,3" FontSize="11.5" Opacity="0.9"
                                                    ToolTip.Tip="{Binding Hash}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                                                    VerticalAlignment="Center">
                                            <Button Content="下载" Tag="{Binding Url}"
                                                    Classes="accent"
                                                    Click="Download_Click" />
                                            <Button Tag="{Binding Url}" Click="Mirror_Click"
                                                    IsVisible="{Binding MirrorVisibility}">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <ui:FASymbolIcon Symbol="Globe" FontSize="12" />
                                                    <TextBlock Text="加速下载" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 数据问题（该软件的 JSON 有问题时会提示） -->
                    <ui:FAInfoBar x:Name="IssueBar" Severity="Warning" IsOpen="False" IsClosable="False" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
