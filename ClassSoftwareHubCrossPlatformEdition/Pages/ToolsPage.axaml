<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:data="using:ClassSoftwareHubCrossPlatformEdition.Data"
             x:Class="ClassSoftwareHubCrossPlatformEdition.Pages.ToolsPage">

    <!-- 和首页 / 设置页 / 软件下载页同一套版式：内容钉在中间 960 宽 -->
    <Grid Margin="24,36,24,44">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="998*" MaxWidth="960" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="1" RowSpacing="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="内置工具" FontSize="30" FontWeight="Bold" />

            <!-- 6 个工具：卡片 462 + 间距 16 = 478，960 里正好两列；单行卡片（图标 + 名称 + 箭头） -->
            <ItemsControl x:Name="ToolGrid" Grid.Row="1" Classes="cshcard" Tapped="ToolGrid_Tapped">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="data:ToolDef">
                        <Border Width="462" Height="64" CornerRadius="8" Padding="20,0" Margin="0,0,16,14"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                Tag="{Binding Id}"
                                PointerEntered="Card_PointerEntered" PointerExited="Card_PointerExited">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:FASymbolIcon Symbol="{Binding Symbol}" FontSize="20" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="15" FontWeight="Bold"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <ui:FASymbolIcon Grid.Column="2" Symbol="ChevronRight" FontSize="13" Opacity="0.5"
                                                 VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- ===== 常用工具窗口：开关就放这儿，跟首页「体验网页版」那张卡一个意思 ===== -->
            <Border Grid.Row="2" CornerRadius="8" Padding="20,16" Margin="0,4,0,0"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid ColumnSpacing="16" RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ui:FASymbolIcon Symbol="AllApps" FontSize="20" VerticalAlignment="Top" />
                    <StackPanel Grid.Column="1" Spacing="3">
                        <TextBlock Text="常用工具窗口" FontSize="15" FontWeight="Bold" />
                        <TextBlock FontSize="12.5" Opacity="0.7" TextWrapping="Wrap"
                                   Text="一个置顶小窗口，只放四个常用的：随机抽号、课堂计时、秒表计时、全屏时钟。不用打开主界面 —— 系统托盘里有它自己的图标，点一下就出来（窗口能拖，Esc 收起来）。屏幕边上还有一条更省事的「侧边栏」，全屏放 PPT 时也点得到。" />
                        <TextBlock FontSize="12" Opacity="0.6" TextWrapping="Wrap"
                                   Text="跨平台版暂时没有独立的工具浮窗：侧边栏模块可以在「侧边布局」页里挑好并保存，开关在「设置 → 常用工具」里。" />
                    </StackPanel>
                    <Button Grid.Column="2" Content="看看都有什么" Classes="accent"
                            VerticalAlignment="Top" Click="OpenPalette_Click" />

                    <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Orientation="Horizontal" Spacing="28">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="点关闭时收进托盘" FontSize="13" VerticalAlignment="Center" />
                            <ToggleSwitch x:Name="TraySwitch" OnContent="开" OffContent="关"
                                          IsCheckedChanged="TraySwitch_Toggled" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
