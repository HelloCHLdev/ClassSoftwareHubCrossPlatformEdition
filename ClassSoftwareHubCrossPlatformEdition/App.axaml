<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ClassSoftwareHubCrossPlatformEdition.App"
             RequestedThemeVariant="Default"
             xmlns:sty="using:Avalonia.Styling"
             xmlns:fasty="using:FluentAvalonia.Styling"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:uip="using:FluentAvalonia.UI.Controls.Primitives">

    <Application.Resources>
        <ResourceDictionary>
            <!--
              颜色表：WinUI 那套 ThemeResource 键名在 Avalonia 里没有，这里按同样的名字自己定义一份。
              页面里继续写 {DynamicResource CardBackgroundFillColorDefaultBrush} 之类的键，
              主题一变（Avalonia 会换 ThemeDictionary）这些画笔自己跟着变，不用谁手动刷。
            -->
            <ResourceDictionary.ThemeDictionaries>

                <ResourceDictionary x:Key="{x:Static sty:ThemeVariant.Light}">
                    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#E3E3E3" />
                    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#F5F5F5" />
                    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#E1E1E1" />
                    <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="#E5E5E5" />
                    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#1B1B1B" />
                    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#5C5C5C" />
                    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#0F6CBD" />
                    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#0F6CBD" />
                    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="SystemFillColorCautionBrush" Color="#F2B705" />
                    <SolidColorBrush x:Key="SystemFillColorCriticalBrush" Color="#C42B1C" />
                    <SolidColorBrush x:Key="SystemFillColorSuccessBrush" Color="#0F7B0F" />
                    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="#F3F3F3" />
                    <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="#F3F3F3" />
                    <SolidColorBrush x:Key="FlyoutPresenterBackground" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="SystemChromeTitleHoverBackground" Color="#EFEFEF" />
                    <SolidColorBrush x:Key="SystemChromeTitlePressedBackground" Color="#E0E0E0" />
                    <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="#FFFFFF" />
                </ResourceDictionary>

                <ResourceDictionary x:Key="{x:Static sty:ThemeVariant.Dark}">
                    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#2F2F2F" />
                    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#3D3D3D" />
                    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#2B2B2B" />
                    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#333333" />
                    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#3A3A3A" />
                    <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="#3A3A3A" />
                    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#C5C5C5" />
                    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#3F8FCC" />
                    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#6CB6F0" />
                    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#0A0A0A" />
                    <SolidColorBrush x:Key="SystemFillColorCautionBrush" Color="#F7C948" />
                    <SolidColorBrush x:Key="SystemFillColorCriticalBrush" Color="#FF8A80" />
                    <SolidColorBrush x:Key="SystemFillColorSuccessBrush" Color="#6CCB5F" />
                    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="#1F1F1F" />
                    <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="#1F1F1F" />
                    <SolidColorBrush x:Key="FlyoutPresenterBackground" Color="#2B2B2B" />
                    <SolidColorBrush x:Key="SystemChromeTitleHoverBackground" Color="#2F2F2F" />
                    <SolidColorBrush x:Key="SystemChromeTitlePressedBackground" Color="#383838" />
                    <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="#2B2B2B" />
                </ResourceDictionary>

            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <fasty:FluentAvaloniaTheme />

        <!--
          全局字体：HarmonyOS Sans（Thin/Light/Regular/Medium/Bold/Black 六个字重都在 Assets/fonts）。

          要挂两处，缺一不可：
            · Window —— FontFamily 是继承属性，窗口上设一次，主视觉树整支都跟着走；
            · ContextMenu / ToolTip —— 弹出层挂在独立的 PopupRoot 上，继承链从那儿断掉，
              不显式设的话会退回 $Default（Inter），菜单和悬浮提示里的中文就不是 HarmonyOS 了。

          指向目录而不是单个 ttf：Avalonia 会把目录里同族（HarmonyOS Sans）的字体合成一个字族，
          FontWeight 再自动挑对应字重 —— 600 的 SemiBold 落到 Medium，700 落到 Bold。
        -->
        <Style Selector="Window">
            <Setter Property="FontFamily"
                    Value="avares://ClassSoftwareHubCrossPlatformEdition/Assets/fonts/#HarmonyOS Sans" />
        </Style>
        <Style Selector="ContextMenu">
            <Setter Property="FontFamily"
                    Value="avares://ClassSoftwareHubCrossPlatformEdition/Assets/fonts/#HarmonyOS Sans" />
        </Style>
        <Style Selector="ToolTip">
            <Setter Property="FontFamily"
                    Value="avares://ClassSoftwareHubCrossPlatformEdition/Assets/fonts/#HarmonyOS Sans" />
        </Style>

        <!--
          卡片墙：WinUI 那边靠 CshCardItemStyle 把 GridViewItem 的焦点框/悬停底色关掉，
          Avalonia 的 ItemsControl 没有 ItemContainerStyle，容器是 WrapPanel 里的 ContentPresenter，
          所以改成一条全局规则把容器 chrome 抹平（真正的卡片外观在各自的 DataTemplate 里）。
        -->
        <Style Selector="ItemsControl.cshcard">
            <Setter Property="ItemsPanel">
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </Setter>
        </Style>
        <Style Selector="ItemsControl.cshcard > ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Focusable" Value="False" />
        </Style>

        <!-- 强调按钮：WinUI 的 AccentButtonStyle 这边没有，用 Classes="accent" 顶上 -->
        <Style Selector="Button.accent">
            <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Button.accent:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
            <Setter Property="Opacity" Value="0.85" />
        </Style>
        <Style Selector="Button.accent:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
            <Setter Property="Opacity" Value="0.7" />
        </Style>
        <Style Selector="Button.accent:disabled /template/ ContentPresenter">
            <Setter Property="Opacity" Value="0.4" />
        </Style>

        <!-- 页面统一的滚动条留白：内容区 3 列 Grid 已经钉在中间 960 宽，这里只去掉多余的边框 -->
        <Style Selector="TextBlock.muted">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style Selector="TextBlock.title">
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
    </Application.Styles>
</Application>
