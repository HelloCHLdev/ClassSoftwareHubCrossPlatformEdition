<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="820"
        x:Class="ClassSoftwareHubCrossPlatformEdition.MainWindow"
        xmlns:pages="using:ClassSoftwareHubCrossPlatformEdition.Pages"
        Title="ClassSoftwareHub 跨平台版">

    <!-- 背景板：backdrop 走半透明（acrylic / mica / blur）时画笔带 alpha，窗口自己的层次透上来 -->
    <Grid x:Name="RootGrid">
        <pages:ShellPage x:Name="NativeShell" />
    </Grid>
</Window>
